# Copy this file outside the Git checkout, replace every <...> value, and keep both checkouts clean.
# Run it through prepare_and_submit_cs2_clariden_sweep.sh; do not use MIRA's x86-only Pixi env on
# Clariden's ARM64 GH200 nodes.
MIRA_PROJECT_DIR="<iops-scratch>/cs2-rebuttal/mira"
CS1K_RELEASE_DIR="<iops-scratch>/cs2-rebuttal/CounterStrike-1K"
CS1K_CLARIDEN_VENV="<iops-scratch>/cs2-rebuttal/venv-uenv-pt2.8-v1"
CS1K_CLARIDEN_UENV="pytorch/v2.8.0:v1"

# CSCS recommends Iopsstor for randomly read training data and Capstor for checkpoints/outputs.
CS1K_DATASET_DIR="<iops-scratch>/cs2-rebuttal/data/cs1k-360p"
CS1K_MANIFEST_PATH="<iops-scratch>/cs2-rebuttal/data/cs1k-360p/manifest_dust2_confirmatory_spatial_v1.parquet"
CS1K_CONFIRMATORY_SPLIT_PROVENANCE="<iops-scratch>/cs2-rebuttal/data/cs1k-360p/manifest_dust2_confirmatory_spatial_v1.provenance.json"
CS1K_CODEC_CHECKPOINT="<capstor-scratch>/cs2-rebuttal/checkpoints/codec/checkpoint-18000/checkpoint.pth"
CS1K_SINGLE_CHECKPOINT="<capstor-scratch>/cs2-rebuttal/checkpoints/mira-single-step15000/checkpoint.pth"
CS1K_EXPECTED_CODEC_CHECKPOINT_SHA256="3c286c59b74cd141e72af69cde1a0a005142d8d2b472c789cdf2a39a140c4b7a"
CS1K_EXPECTED_SINGLE_CHECKPOINT_SHA256="3dbd8f0e43dbe833a5f36370d75f6306c7aa036dfcd3edba767ab138232fa047"
CS1K_OUTPUT_ROOT="<capstor-scratch>/cs2-rebuttal/runs/mira_dust2_sync_fixed10k_1node4gpu_v6"

# Recovery-only fast path: export CS1K_REUSE_LOADER_SELECTION before invoking the preparation
# wrapper to reuse a previously passed full GH200 selection. Every new node still runs a cheap
# synchronized+cross-round smoke with the frozen configuration.
# CS1K_REUSE_LOADER_SELECTION="<capstor-scratch>/.../frozen_loader_selection_global.json"

CS1K_TRAIN_STEPS=10000
CS1K_ARM_HOURS=4
CS1K_TRAINING_SEEDS="28 29 30"
CS1K_EVENT_FEATURE_SEED=37
CS1K_EVENT_PROBE_SEEDS="17 29 43"
CS1K_EVENT_BOOTSTRAP_SAMPLES=10000

CS1K_SLURM_ACCOUNT="<account>"
CS1K_GH200_PARTITION="normal"
CS1K_TRAINING_TIME=12:00:00
CS1K_EVENT_TIME=04:00:00
CS1K_FINALIZE_TIME=00:30:00

# The preparation wrapper supplies the pinned uenv flags. Add only genuinely required
# site-specific flags such as a reservation here; otherwise leave both unset.
# CS1K_TRAIN_SBATCH_ARGS="--reservation=<reservation>"
# CS1K_AUX_SBATCH_ARGS="--reservation=<reservation>"
